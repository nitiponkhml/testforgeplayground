# Copy to .env and adjust as needed.
# On the deploy platform these are injected at runtime — do not hardcode.

# Port the app must listen on (next start reads this automatically).
PORT=3000

# Postgres connection (always present on the platform).
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Redis connection (OPTIONAL). Leave unset to run without a cache.
# REDIS_URL=redis://localhost:6379

APP_ENV=development
SUPPORT_EMAIL=support@example.com

# Set to "off" to disable ANSI colors in backend logs (useful in CI).
LOG_COLOR=on
